# Copy this file to .env and fill in your real values. Never commit .env.

# --- Groww API credentials ---
# Get these from Groww app/web: Profile > Settings > Trading APIs > Generate API keys.
# Groww supports either secret-based or TOTP-based access token generation.
GROWW_API_KEY=
GROWW_API_SECRET=
# Only needed if you use the TOTP flow instead of API_SECRET:
GROWW_TOTP_SECRET=

# --- Trading parameters ---
TRADING_SYMBOL=RELIANCE
EXCHANGE=NSE
CAPITAL=50000
RISK_PER_TRADE_PCT=1.0
STOP_LOSS_PCT=1.5
TARGET_PCT=3.0
MAX_DAILY_LOSS_PCT=3.0
MAX_OPEN_POSITIONS=1

# --- Strategy parameters (SMA crossover) ---
SHORT_SMA=20
LONG_SMA=50

# --- Engine ---
POLL_INTERVAL_SECONDS=60

# --- Safety switch for live trading (must be exactly YES) ---
CONFIRM_LIVE_TRADING=NO
